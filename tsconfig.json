{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "malang-ui": ["./src/index.ts"] },
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "stories/**/*.ts", "tests/**/*.ts", ".storybook/**/*.ts", "website/**/*.ts", "website/**/*.vue", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.website.config.ts"],
  "exclude": ["tests/consumer"]
}
