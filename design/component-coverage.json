  "items": [
    {
      "id": "space",
      "capability": "组件间距",
      "antDesign": "Space",
      "elementPlus": "Space",
      "status": "available",
      "priority": null,
      "components": [
        "MSpace"
      ],
      "available": "横纵排列、间距、对齐与换行。",
      "boundary": "负责组件之间的留白；不提供栅格、页面布局或可拖动分栏。",
      "next": "用于按钮组、筛选项与信息行。"
    },
    {
      "id": "backtop",
      "capability": "返回顶部",
      "antDesign": "FloatButton.BackTop",
      "elementPlus": "Backtop",
      "status": "available",
      "priority": null,
      "components": [
        "MBackTop"
      ],
      "available": "按滚动高度显隐，返回页面或指定滚动容器的顶部。",
      "boundary": "支持减少动态效果；不包含浮动按钮菜单、进度环或锚点导航。",
      "next": "用于长文档和滚动面板。"
    },
    {
      "id": "message",
      "capability": "操作后轻提示",
      "antDesign": "Message",
      "elementPlus": "Message",
      "status": "available",
      "priority": null,
      "components": [
        "MMessage"
      ],
      "available": "MMessage 提供顶部居中、默认3秒的单句轻提示，支持信息、成功、警告、错误与加载五种类型。",
      "boundary": "受控 v-model，沿用主题与 Toast 计时/播报能力；不创建全局命令式消息服务。MToast 默认 notification 保留详情通知。",
      "next": "保存、复制等短反馈使用 message；较完整通知使用 notification。"
    },
    {
      "id": "form-controls",
      "capability": "表单基础控件",
      "antDesign": "Button / Input / Select / Radio / Checkbox / DatePicker / Upload 等",
      "elementPlus": "Button / Input / Select / Radio / Checkbox / Date Picker / Upload 等",
      "status": "available",
      "priority": null,
      "components": [
        "MButton",
        "MInput",
        "MTextarea",
        "MInputNumber",
        "MSelect",
        "MCombobox",
        "MCheckbox",
        "MRadioGroup",
        "MSwitch",
        "MSlider",
        "MDatePicker",
        "MUpload"
      ],
      "available": "11 个输入与选择组件，加原生表单动作按钮，共 12 个基础控件。保留 name、required、禁用及原生表单语义。",
      "boundary": "搜索选择、单日期和本地文件选择各有边界；控件本身不实现多选级联或远程上传。",
      "next": "先用现有控件组合真实表单，再按需求增加专用输入。"
    },
    {
      "id": "content",
      "capability": "内容容器与标记",
      "antDesign": "Card / Divider / Tag / Avatar / Badge / Empty",
      "elementPlus": "Card / Divider / Tag / Avatar / Badge / Empty",
      "status": "available",
      "priority": null,
      "components": [
        "MCard",
        "MDivider",
        "MTag",
        "MAvatar",
        "MBadge",
        "MEmpty"
      ],
      "available": "卡片分区、分隔、标签、头像、状态与空内容。",
      "boundary": "头像提供身份图像与回退，不提供图片画廊或大图预览。",
      "next": "配合业务内容使用独立的状态与层级。"
    },
    {
      "id": "data",
      "capability": "数据与页面结果",
      "antDesign": "Table / Tree / Descriptions / Statistic / Result",
      "elementPlus": "Table / Tree / Descriptions / Statistic / Result",
      "status": "available",
      "priority": null,
      "components": [
        "MTable",
        "MTree",
        "MDescriptions",
        "MStatistic",
        "MResult"
      ],
      "available": "基础语义表格、层级目录、资料描述、静态指标与页面级结果。",
      "boundary": "表格与树不做虚拟渲染；指标不伪造数值增长。表格没有内置排序、筛选或编辑引擎。",
      "next": "复杂数据交互与大数据量能力单独评估。"
    },
    {
      "id": "navigation",
      "capability": "导航与流程",
      "antDesign": "Tabs / Menu / Dropdown / Breadcrumb / Pagination / Steps",
      "elementPlus": "Tabs / Menu / Dropdown / Breadcrumb / Pagination / Steps",
      "status": "available",
      "priority": null,
      "components": [
        "MTabs",
        "MMenu",
        "MDropdownMenu",
        "MBreadcrumb",
        "MPagination",
        "MSteps"
      ],
      "available": "标签切换、菜单、操作下拉、路径、分页与步骤。",
      "boundary": "路由跳转与业务步骤校验由页面负责；操作菜单不代替表单选择器。",
      "next": "结合项目路由与流程状态使用。"
    },
    {
      "id": "overlays",
      "capability": "浮层与折叠",
      "antDesign": "Modal / Drawer / Popover / Tooltip / Collapse",
      "elementPlus": "Dialog / Drawer / Popover / Tooltip / Collapse",
      "status": "available",
      "priority": null,
      "components": [
        "MDialog",
        "MDrawer",
        "MPopover",
        "MTooltip",
        "MAccordion"
      ],
      "available": "对话框、抽屉、气泡、提示与折叠面板。Collapse 对应 MAccordion。",
      "boundary": "通用气泡、模态与文本说明各自保留焦点契约；专用轻确认见Popconfirm。",
      "next": "需要确认动作时优先遵循独立的确认交互约定。"
    },
    {
      "id": "feedback",
      "capability": "状态、加载与通知",
      "antDesign": "Alert / Progress / Timeline / Spin / Skeleton / Notification",
      "elementPlus": "Alert / Progress / Timeline / Loading / Skeleton / Notification",
      "status": "available",
      "priority": null,
      "components": [
        "MAlert",
        "MProgress",
        "MTimeline",
        "MSpinner",
        "MSkeleton",
        "MToast",
        "MToastViewport"
      ],
      "available": "行内提示、确定进度、时间线、内联加载与骨架；Notification 对应 MToast 默认通知模式。",
      "boundary": "Spinner 表示处理中，不表示完成百分比；没有 Loading 遮罩服务或全局通知服务。",
      "next": "依据已知进度、局部等待或通知选择相应形式。"
    },
    {
      "id": "segmented",
      "capability": "分段选择",
      "antDesign": "Segmented",
      "elementPlus": "Segmented",
      "status": "added",
      "priority": null,
      "components": [
        "MSegmented"
      ],
      "available": "原生单选语义、机械滑块、横纵方向、尺寸、键盘、受控值与真实FormData。",
      "boundary": "用于选择值或视图条件；面板内容由页面管理，不替代Tabs。",
      "next": "用于列表视图、分类与短选项筛选。"
    },
    {
      "id": "popconfirm",
      "capability": "轻量操作确认",
      "antDesign": "Popconfirm",
      "elementPlus": "Popconfirm",
      "status": "added",
      "priority": null,
      "components": [
        "MPopconfirm"
      ],
      "available": "轻量确认、取消回焦、受控开合、可取消的异步确认与失败重试。",
      "boundary": "不创建命令式全局确认服务；异步业务通过beforeConfirm回调提供。",
      "next": "用于档案移除、清空等局部确认。"
    },
    {
      "id": "image",
      "capability": "图片与大图预览",
      "antDesign": "Image",
      "elementPlus": "Image",
      "status": "added",
      "priority": null,
      "components": [
        "MImage"
      ],
      "available": "加载、失败与重试，原生懒加载、图片组预览、缩放、键盘与模态回焦。",
      "boundary": "不包含裁剪、图像编辑、上传或服务端图片处理。",
      "next": "用于作品档案、素材画廊与详情大图。"
    },
    {
      "id": "form",
      "capability": "表单布局与验证",
      "antDesign": "Form / Form.Item",
      "elementPlus": "Form / FormItem",
      "status": "added",
      "priority": null,
      "components": [
        "MForm",
        "MFormItem"
      ],
      "available": "原生form、显式字段绑定、必填/边界/正则、跨字段与可取消的异步校验、原生validity、错误摘要、焦点与受控reset。",
      "boundary": "字段名直接对应model属性；不解析嵌套路径、不做动态Form.List或自动双向注入。",
      "next": "组合现有输入组件，接入实际业务验证与提交。"
    },
